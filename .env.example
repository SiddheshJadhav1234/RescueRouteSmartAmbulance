# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server configuration
PORT=3000
NODE_ENV="development"

# Supabase PostgreSQL Configuration (Used strictly server-side by Node.js backend)
# Provide your Supabase project URL and service role key if connecting to live Supabase database.
# If not provided, RescueRoute automatically operates in self-contained deterministic mode with the C++ engine.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
